# ==============================================================================
# AI Medical/AI News Research & WordPress Auto-Publisher Configuration
# ==============================================================================

# Anthropic Claude API Key (Required for AI generation)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Search Provider Configuration ('serpapi', 'newsapi', 'bing', or 'mock')
# In 'mock' mode, realistic test articles are returned without consuming search credits.
SEARCH_PROVIDER=mock
SERPAPI_API_KEY=your_serpapi_key_here
NEWSAPI_API_KEY=your_newsapi_key_here
BING_API_KEY=your_bing_key_here
SEARCH_LOOKBACK_DAYS=7

# WordPress Integration
# The root URL of your WordPress site (without trailing slash)
WORDPRESS_URL=http://localhost:8080
# The secret API key generated by the AI News Publisher WordPress plugin
WORDPRESS_API_KEY=your_wordpress_plugin_api_key_here
WORDPRESS_TIMEOUT=30

# Deduplication Threshold (0.0 to 1.0)
# Posts with cosine similarity >= this threshold are flagged as duplicates
DEDUP_SIMILARITY_THRESHOLD=0.80

# Review Gate Policy
# Set to 'true' to auto-push valid drafts directly to WordPress as draft posts.
# Set to 'false' to hold drafts in the Dashboard for 1-click human editorial approval.
AUTO_PUSH_TO_WP=false

# Background Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=6
